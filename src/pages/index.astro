---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";
import profileImage from "../assets/profile.jpg";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

const talks = (await getCollection("talks"))
  .filter(talk => !talk.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_TALKS_ON_HOMEPAGE);

const research = (await getCollection("research"))
  .filter(item => !item.data.draft)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, SITE.NUM_RESEARCH_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Hi, I'm Matthias <span class="text-xl">👋🏻</span> 
    </h4>
    <div class="animate mt-4 flex justify-center">
      <Image
        src={profileImage}
        alt="Portrait of Matthias"
        width={384}
        height={384}
        quality={95}
        format="webp"
        class="h-48 w-48 rounded-full object-cover ring-1 ring-black/10 dark:ring-white/20"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate text-justify leading-relaxed">
            I am a Software Engineer with a strong focus on Node.js, TypeScript, developer tooling and REST APIs, with professional experience since 2018. My work centers around building robust and reliable APIs and systems as well as CLI tools that enable efficient and reliable software development. Over the past years, I have developed a particular specialization in HTTP and REST API design and development.  Both professionally and privately, I contribute to open-source projects such as Thymian and Fastify. You can follow my work on my <a href="https://github.com/matthyk" target="_blank" rel="noopener noreferrer">GitHub profile</a>.
          </p>
          <p class="animate text-justify leading-relaxed">
            With the rise of increasingly complex and distributed systems, I see reliable API behavior and protocol correctness as a critical foundation for modern software. This importance is further amplified by the growing adoption of agentic AI, where systems autonomously interact with APIs and depend on predictable and well-defined interfaces. As development speed continues to increase, ensuring correctness, observability, and confidence in systems becomes more challenging—and more essential.
          </p>
          <p class="animate text-justify leading-relaxed">
            In addition to my core focus areas, I have experience working with Java and Kotlin, as well as developing customized chatbot solutions. I have also been involved in product development and strategic decision-making, contributing to the definition of features, priorities, and overall product direction.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Work
          </h5>
          <Link href="/cv">
            See full CV
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Talks
          </h5>
          <Link href="/talks">
            See all talks
          </Link>
        </div>
        {talks.length > 0 ? (
          <ul class="flex flex-col gap-4">
            {talks.map(talk => (
              <li>
                <ArrowCard entry={talk} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="opacity-75">No talks added yet.</p>
        )}
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Research
          </h5>
          <Link href="/research">
            See all research
          </Link>
        </div>
        {research.length > 0 ? (
          <ul class="flex flex-col gap-4">
            {research.map(item => (
              <li>
                <ArrowCard entry={item} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="opacity-75">No research added yet.</p>
        )}
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            If you want to get in touch with me about something or just to say hi,
            reach out on social media.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
